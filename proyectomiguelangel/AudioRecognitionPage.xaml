<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="proyectomiguelangel.AudioRecognitionPage"
             Title="Identificar Canción"
             BackgroundColor="#0F0B23">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Frame BackgroundColor="#1A173A" 
                   Padding="15" 
                   CornerRadius="15"
                   BorderColor="#9B59B6">
                <VerticalStackLayout Spacing="10">
                    <Label Text="🎤 Identificador de Canciones" 
                           TextColor="#FFFFFF"
                           FontSize="20" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center" />

                    <Label Text="Graba un fragmento de audio para identificar la canción" 
                           FontSize="14" 
                           TextColor="#BBBBBB"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Frame>

            <!-- Estado de grabación -->
            <Frame x:Name="RecordingStatusFrame"
                   IsVisible="False"
                   BackgroundColor="#2C3E50"
                   Padding="15"
                   CornerRadius="15"
                   BorderColor="#27AE60">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <ActivityIndicator x:Name="RecordingIndicator"
                                      IsRunning="True"
                                      Color="#27AE60" />
                    <Label x:Name="RecordingStatusLabel"
                           Text="Escuchando..."
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#FFFFFF"
                           HorizontalOptions="Center" />

                    <!-- CONTADOR DE TIEMPO -->
                    <Label x:Name="RecordingTimerLabel"
                           Text="00:00"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#27AE60"
                           HorizontalOptions="Center" />

                    <Label Text="Reproduce la canción que quieres identificar"
                           FontSize="12"
                           TextColor="#BBBBBB"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Frame>

            <!-- Controles de grabación -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                <Button x:Name="StartRecordingButton"
                        Grid.Column="0"
                        Text="🎤 Iniciar Grabación"
                        Clicked="OnStartRecordingClicked"
                        BackgroundColor="#27AE60"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        HeightRequest="50"
                        CornerRadius="10" />

                <Button x:Name="StopRecordingButton"
                        Grid.Column="1"
                        Text="⏹️ Detener"
                        Clicked="OnStopRecordingClicked"
                        BackgroundColor="#E74C3C"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        HeightRequest="50"
                        CornerRadius="10"
                        IsEnabled="False" />
            </Grid>

            <!-- Resultados -->
            <Frame x:Name="ResultsFrame"
                   IsVisible="False"
                   BackgroundColor="#1A173A"
                   Padding="15"
                   CornerRadius="15"
                   BorderColor="#3498DB">
                <VerticalStackLayout Spacing="10">
                    <Label Text="🎵 Canción Identificada" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           TextColor="#FFFFFF" />

                    <Label x:Name="SongTitleLabel"
                           Text=""
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#FFFFFF" />

                    <Label x:Name="ArtistLabel"
                           Text=""
                           FontSize="14"
                           TextColor="#3498DB" />

                    <Label x:Name="AlbumLabel"
                           Text=""
                           FontSize="12"
                           TextColor="#BBBBBB" />

                    <Grid ColumnDefinitions="100,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="15"
                          Margin="0,10,0,0">

                        <!-- Carátula -->
                        <Image x:Name="CoverImage"
                               Grid.Row="0"
                               Grid.RowSpan="2"
                               Grid.Column="0"
                               HeightRequest="100"
                               WidthRequest="100"
                               Aspect="AspectFill"
                               BackgroundColor="#2C3E50" />

                        <!-- Texto preview -->
                        <Label Grid.Row="0"
                               Grid.Column="1"
                               Text="🎧 Preview de 30 segundos"
                               FontSize="12"
                               TextColor="#BBBBBB" />

                        <!-- Botón Preview -->
                        <HorizontalStackLayout
                            Grid.Row="1"
                            Grid.Column="1"
                            Spacing="10">

                            <Button x:Name="PreviewPlayButton"
                                    Text="▶ Reproducir"
                                    BackgroundColor="#27AE60"
                                    TextColor="White"
                                    FontSize="14"
                                    HeightRequest="40"
                                    CornerRadius="8"
                                    IsVisible="False"
                                    Clicked="OnPlayPreviewClicked" />

                            <Button x:Name="PreviewPauseButton"
                                    Text="⏸ Pausa"
                                    BackgroundColor="#3498DB"
                                    TextColor="White"
                                    FontSize="14"
                                    HeightRequest="40"
                                    CornerRadius="8"
                                    IsVisible="False"
                                    Clicked="OnPausePreviewClicked" />
                        </HorizontalStackLayout>
                    </Grid>

                    <HorizontalStackLayout Spacing="15"
                                           HorizontalOptions="Center"
                                           Margin="0,10,0,0">

                        <Button x:Name="YouTubeButton"
                                Text="▶ YouTube"
                                BackgroundColor="#FF0000"
                                TextColor="White"
                                FontSize="14"
                                HeightRequest="40"
                                CornerRadius="8"
                                Clicked="OnOpenYouTubeClicked" />

                        <Button x:Name="SpotifyButton"
                                Text="🎧 Spotify"
                                BackgroundColor="#1DB954"
                                TextColor="White"
                                FontSize="14"
                                HeightRequest="40"
                                CornerRadius="8"
                                Clicked="OnOpenSpotifyClicked" />
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Frame>

            <!-- Información -->
            <Frame BackgroundColor="#1A173A" 
                   Padding="15" 
                   CornerRadius="15"
                   BorderColor="#F39C12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="💡 Cómo usar:" 
                           FontSize="16" 
                           FontAttributes="Bold"
                           TextColor="#F39C12"/>
                    <Label Text="• Haz clic en 'Iniciar Grabación'" 
                           FontSize="12" 
                           TextColor="#BBBBBB"/>
                    <Label Text="• Reproduce la canción que quieres identificar" 
                           FontSize="12"
                           TextColor="#BBBBBB"/>
                    <Label Text="• Haz clic en 'Detener' después de 20-25 segundos" 
                           FontSize="12"
                           TextColor="#BBBBBB"/>
                    <Label Text="• La aplicación identificará la canción automáticamente" 
                           FontSize="12" 
                           TextColor="#BBBBBB"/>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>