<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:proyectomiguelangel.Converters"
             x:Class="proyectomiguelangel.SongHistoryPage"
             Title="📜 Historial"
             BackgroundColor="#0F0B23">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
            <converters:SourceToIconConverter x:Key="SourceToIconConverter" />
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />

            <!-- Estilos para botones de preview -->
            <Style x:Key="PreviewPlayButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#27AE60"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="HeightRequest" Value="35"/>
                <Setter Property="CornerRadius" Value="8"/>
            </Style>

            <Style x:Key="PreviewPauseButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#3498DB"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="HeightRequest" Value="35"/>
                <Setter Property="CornerRadius" Value="8"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- FILA 0: Filtros -->
        <Frame Grid.Row="0" 
               BackgroundColor="#1A173A" 
               Padding="15"
               Margin="10,10,10,5"
               CornerRadius="15"
               BorderColor="#9B59B6">

            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto, Auto, Auto">

                <!-- Fila 0: Título y botón limpiar -->
                <Label Grid.Row="0" Grid.Column="0"
                       Text="Filtrar historial"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="#FFFFFF"
                       VerticalOptions="Center"/>

                <Button Grid.Row="0" Grid.Column="1"
                        Text="🗑️ Limpiar todo"
                        BackgroundColor="#E74C3C"
                        TextColor="White"
                        FontSize="14"
                        FontAttributes="Bold"
                        HeightRequest="40"
                        CornerRadius="20"
                        Clicked="OnClearHistoryClicked"
                        Margin="10,0,0,0"
                        Padding="15,0"/>

                <!-- Fila 1: Picker (ocupa ambas columnas) -->
                <Picker Grid.Row="1" Grid.ColumnSpan="2"
                        x:Name="FilterPicker"
                        Title="Seleccionar filtro..."
                        TitleColor="#BBBBBB"
                        TextColor="#FFFFFF"
                        BackgroundColor="#2C3E50"
                        Margin="0,15,0,0"
                        SelectedIndexChanged="OnFilterChanged">
                    <Picker.Items>
                        <x:String>📋 Todas las canciones</x:String>
                        <x:String>🎤 Solo identificadas por audio</x:String>
                        <x:String>🔍 Solo búsquedas por letra</x:String>
                    </Picker.Items>
                </Picker>

                <!-- Fila 2: Botones de filtro rápido (ocupa ambas columnas) -->
                <Grid Grid.Row="2" Grid.ColumnSpan="2" 
                      ColumnDefinitions="*,*,*" 
                      ColumnSpacing="10"
                      Margin="0,15,0,0">
                    <Button Grid.Column="0"
                            x:Name="BtnAll"
                            Text="📋 Todas"
                            BackgroundColor="#2C3E50"
                            TextColor="#FFFFFF"
                            FontSize="12"
                            HeightRequest="40"
                            CornerRadius="8"
                            Clicked="OnQuickFilterAll"
                            BorderColor="#9B59B6"
                            BorderWidth="0.5"/>

                    <Button Grid.Column="1"
                            x:Name="BtnAudio"
                            Text="🎤 Audio"
                            BackgroundColor="#2C3E50"
                            TextColor="#FFFFFF"
                            FontSize="12"
                            HeightRequest="40"
                            CornerRadius="8"
                            Clicked="OnQuickFilterAudio"
                            BorderColor="#27AE60"
                            BorderWidth="0.5"/>

                    <Button Grid.Column="2"
                            x:Name="BtnLyrics"
                            Text="🔍 Letra"
                            BackgroundColor="#2C3E50"
                            TextColor="#FFFFFF"
                            FontSize="12"
                            HeightRequest="40"
                            CornerRadius="8"
                            Clicked="OnQuickFilterLyrics"
                            BorderColor="#3498DB"
                            BorderWidth="0.5"/>
                </Grid>

                <!-- Fila 3: Contador de resultados (ocupa ambas columnas) -->
                <Grid Grid.Row="3" Grid.ColumnSpan="2" 
                      ColumnDefinitions="*,*"
                      Margin="0,15,0,0">
                    <Label Grid.Column="0"
                           Text="Resultados:"
                           FontSize="14"
                           TextColor="#BBBBBB"
                           HorizontalOptions="End"/>

                    <Label x:Name="CountLabel"
                           Grid.Column="1"
                           Text="0"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#27AE60"
                           HorizontalOptions="Start"
                           Margin="10,0,0,0"/>
                </Grid>
            </Grid>
        </Frame>

        <!-- FILA 1: Lista de historial -->
        <RefreshView Grid.Row="1"
                     x:Name="RefreshView"
                     Refreshing="OnRefresh"
                     Margin="0,5,0,0">

            <CollectionView x:Name="HistoryCollectionView"
                            ItemsSource="{Binding FilteredSongs}"
                            VerticalScrollBarVisibility="Always">

                <CollectionView.EmptyView>
                    <StackLayout HorizontalOptions="Center" 
                                 VerticalOptions="Center"
                                 Padding="40"
                                 Spacing="20">
                        <Label Text="📜"
                               FontSize="48"
                               HorizontalOptions="Center" />
                        <Label Text="No hay canciones en el historial"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#FFFFFF"/>
                        <Label Text="Las canciones que identifiques o busques aparecerán aquí"
                               FontSize="14"
                               HorizontalOptions="Center"
                               TextColor="#BBBBBB"
                               HorizontalTextAlignment="Center"/>
                    </StackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="#1A173A" 
                               Padding="15"
                               CornerRadius="15"
                               Margin="10,5,10,10"
                               BorderColor="{Binding Source, Converter={StaticResource SourceToIconConverter}, ConverterParameter='color'}"
                               HasShadow="True">
                            <VerticalStackLayout Spacing="10">
                                <!-- Encabezado -->
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                    <Frame Grid.Column="0"
                                           BackgroundColor="{Binding Source, Converter={StaticResource SourceToIconConverter}, ConverterParameter='bgcolor'}"
                                           Padding="8,3"
                                           CornerRadius="12"
                                           Margin="0,0,10,0"
                                           HasShadow="False">
                                        <Label Text="{Binding Source, Converter={StaticResource SourceToIconConverter}, ConverterParameter='icon'}"
                                               FontSize="12"
                                               TextColor="#FFFFFF"/>
                                    </Frame>

                                    <Label Grid.Column="1"
                                           Text="{Binding DetectedDate, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                           FontSize="11"
                                           TextColor="#BBBBBB"
                                           VerticalOptions="Center"/>

                                    <Label Grid.Column="2"
                                           Text="{Binding Source}"
                                           FontSize="10"
                                           TextColor="{Binding Source, Converter={StaticResource SourceToIconConverter}, ConverterParameter='textcolor'}"
                                           VerticalOptions="Center"
                                           Margin="0,0,10,0"/>

                                    <Button Grid.Column="3"
                                            Text="❌"
                                            FontSize="12"
                                            BackgroundColor="Transparent"
                                            TextColor="#E74C3C"
                                            WidthRequest="30"
                                            HeightRequest="30"
                                            Clicked="OnDeleteSongClicked"
                                            CommandParameter="{Binding .}"/>
                                </Grid>

                                <!-- Contenido principal -->
                                <Grid ColumnDefinitions="100,*"
                                      RowDefinitions="Auto,Auto,Auto"
                                      ColumnSpacing="15"
                                      Margin="0,5,0,0">
                                    <!-- Carátula -->
                                    <Frame Grid.Row="0"
                                           Grid.RowSpan="3"
                                           Grid.Column="0"
                                           Padding="0"
                                           CornerRadius="10"
                                           BackgroundColor="#2C3E50"
                                           BorderColor="#3498DB"
                                           HeightRequest="100"
                                           WidthRequest="100">
                                        <Image HeightRequest="100"
                                               WidthRequest="100"
                                               Aspect="AspectFill">
                                            <Image.Source>
                                                <UriImageSource Uri="{Binding CoverUrl}" 
                                                               CacheValidity="30:00:00:00" 
                                                               CachingEnabled="True"/>
                                            </Image.Source>
                                        </Image>
                                    </Frame>

                                    <Label Grid.Row="0"
                                           Grid.Column="1"
                                           Text="{Binding Title}" 
                                           FontSize="16" 
                                           FontAttributes="Bold" 
                                           TextColor="#FFFFFF"
                                           LineBreakMode="TailTruncation" />

                                    <Label Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding Artist}"
                                           FontSize="14"
                                           TextColor="#3498DB"
                                           LineBreakMode="TailTruncation" />

                                    <Label Grid.Row="2"
                                           Grid.Column="1"
                                           Text="{Binding Album}"
                                           FontSize="12"
                                           TextColor="#BBBBBB"
                                           LineBreakMode="TailTruncation"
                                           IsVisible="{Binding Album, Converter={StaticResource StringToBoolConverter}}" />
                                </Grid>

                                <!-- Búsqueda original -->
                                <Frame IsVisible="{Binding Source, Converter={StaticResource SourceToIconConverter}, ConverterParameter='showquery'}"
                                       BackgroundColor="#2C3E50"
                                       Padding="10"
                                       CornerRadius="8"
                                       Margin="0,5,0,0">
                                    <Label Text="{Binding SearchQuery, StringFormat='🔍 Buscado: &quot;{0}&quot;'}"
                                           FontSize="11"
                                           TextColor="#F39C12"
                                           LineBreakMode="WordWrap"/>
                                </Frame>

                                <!-- Controles de preview -->
                                <Grid ColumnDefinitions="*,*"
                                      Margin="0,10,0,0">
                                    <!-- Columna izquierda: Preview -->
                                    <Grid Grid.Column="0"
                                          IsVisible="{Binding PreviewUrl, Converter={StaticResource StringToBoolConverter}}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Label Grid.Row="0"
                                               Text="🎧 Preview 30s"
                                               FontSize="12"
                                               TextColor="#BBBBBB"
                                               Margin="0,0,0,5"/>

                                        <HorizontalStackLayout Grid.Row="1"
                                                               Spacing="10"
                                                               x:Name="PreviewButtonsLayout"
                                                               BindingContextChanged="PreviewButtonsLayout_BindingContextChanged">
                                            <Button Text="▶ Reproducir"
                                                    BackgroundColor="#27AE60"
                                                    TextColor="White"
                                                    FontSize="12"
                                                    HeightRequest="35"
                                                    CornerRadius="8"
                                                    Clicked="OnPlayPreviewClicked"
                                                    CommandParameter="{Binding .}"/>

                                            <Button Text="⏸ Pausa"
                                                    BackgroundColor="#3498DB"
                                                    TextColor="White"
                                                    FontSize="12"
                                                    HeightRequest="35"
                                                    CornerRadius="8"
                                                    Clicked="OnPausePreviewClicked"
                                                    CommandParameter="{Binding .}"
                                                    IsVisible="False"/>
                                        </HorizontalStackLayout>
                                    </Grid>

                                    <!-- Columna izquierda alternativa: Sin preview -->
                                    <Frame Grid.Column="0"
                                           BackgroundColor="#2C3E50"
                                           Padding="10"
                                           CornerRadius="8"
                                           IsVisible="{Binding PreviewUrl, Converter={StaticResource InvertedBoolConverter}}">
                                        <Label Text="🎵 Preview no disponible"
                                               FontSize="12"
                                               TextColor="#F39C12"/>
                                    </Frame>

                                    <!-- Columna derecha: YouTube/Spotify -->
                                    <Grid Grid.Column="1"
                                          ColumnDefinitions="*,*"
                                          ColumnSpacing="8"
                                          Margin="0,5,0,0">
                                        <ImageButton Grid.Column="0"
                                                     Source="youtube_icon.png"
                                                     BackgroundColor="#FF0000"
                                                     HeightRequest="35"
                                                     CornerRadius="8"
                                                     Aspect="AspectFit"
                                                     Clicked="OnOpenYouTubeClicked"
                                                     CommandParameter="{Binding .}" />

                                        <ImageButton Grid.Column="1"
                                                     Source="spotify_icon.png"
                                                     BackgroundColor="#1DB954"
                                                     HeightRequest="35"
                                                     CornerRadius="8"
                                                     Aspect="AspectFit"
                                                     Clicked="OnOpenSpotifyClicked"
                                                     CommandParameter="{Binding .}" />
                                    </Grid>
                                </Grid>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- FILA 2: Reproductor (copiado de LyricsSearchPage) -->
        <Frame Grid.Row="2"
               x:Name="AudioPlayerFrame"
               IsVisible="False"
               BackgroundColor="#1A173A"
               Padding="15"
               Margin="10,5,10,10"
               CornerRadius="15">
            <VerticalStackLayout Spacing="10">
                <Label x:Name="NowPlayingLabel"
                       Text="Reproduciendo..." 
                       FontSize="14" 
                       FontAttributes="Bold"
                       TextColor="#FFFFFF"
                       HorizontalOptions="Center" />

                <!-- Panel de coincidencia de letra (siempre oculto en historial) -->
                <Frame x:Name="LyricsMatchFrame"
                       IsVisible="False"
                       BackgroundColor="#2C3E50"
                       Padding="10">
                    <Label x:Name="LyricsMatchLabel"
                           Text=""
                           FontSize="12"
                           TextColor="#27AE60"
                           LineBreakMode="WordWrap" />
                </Frame>

                <Grid ColumnDefinitions="*,*,*" 
                      ColumnSpacing="10"
                      HorizontalOptions="Center">

                    <Button x:Name="PlayButton"
                            Grid.Column="0"
                            Text="▶ Play"
                            Clicked="OnPlayAudioClicked"
                            BackgroundColor="#27AE60"
                            TextColor="White"
                            FontSize="12"
                            HeightRequest="35"
                            CornerRadius="8" />

                    <Button x:Name="PauseButton"
                            Grid.Column="1"
                            Text="⏸️ Pause"
                            Clicked="OnPauseAudioClicked"
                            BackgroundColor="#3498DB"
                            TextColor="White"
                            FontSize="12"
                            HeightRequest="35"
                            CornerRadius="8" />

                    <Button x:Name="StopButton"
                            Grid.Column="2"
                            Text="⏹️ Stop"
                            Clicked="OnStopAudioClicked"
                            BackgroundColor="#E74C3C"
                            TextColor="White"
                            FontSize="12"
                            HeightRequest="35"
                            CornerRadius="8" />
                </Grid>

                <ProgressBar x:Name="AudioProgressBar"
                             Progress="0"
                             HeightRequest="10"
                             ProgressColor="#27AE60"
                             BackgroundColor="#2C3E50" />

                <Label x:Name="TimeLabel"
                       Text="00:00 / 00:30"
                       FontSize="12"
                       TextColor="#BBBBBB"
                       HorizontalOptions="Center" />

                <Button Text="❌ Cerrar"
                        Clicked="OnClosePlayerClicked"
                        BackgroundColor="#9B59B6"
                        TextColor="White"
                        FontSize="12"
                        HorizontalOptions="End"
                        CornerRadius="8" />
            </VerticalStackLayout>
        </Frame>
    </Grid>
</ContentPage>