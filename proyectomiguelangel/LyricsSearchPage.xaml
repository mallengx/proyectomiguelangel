<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:proyectomiguelangel.Converters"
             x:Class="proyectomiguelangel.LyricsSearchPage"
             Title="Buscar Letras"
             BackgroundColor="#0F0B23">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Fila 0: Búsqueda -->
        <VerticalStackLayout Grid.Row="0" Padding="20" Spacing="15">
            <Entry x:Name="txtBusqueda"
                   Placeholder="Escribe parte de la letra..."
                   PlaceholderColor="#BBBBBB"
                   TextColor="#FFFFFF"
                   FontSize="18"
                   BackgroundColor="#1A173A"
                   HeightRequest="50"
                   ClearButtonVisibility="WhileEditing"/>

            <Button Text="Buscar canción 🎵"
                    Clicked="OnBuscarClicked"
                    BackgroundColor="#27AE60"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    CornerRadius="10" />
        </VerticalStackLayout>

        <!-- Fila 1: Loading Indicator -->
        <ActivityIndicator Grid.Row="1"
                           x:Name="LoadingIndicator"
                           IsVisible="False"
                           IsRunning="False"
                           Color="#27AE60"
                           HeightRequest="30"
                           HorizontalOptions="Center"
                           Margin="0,0,0,10" />

        <!-- Fila 2: Lista de canciones CON SCROLL -->
        <ScrollView Grid.Row="2">
            <CollectionView x:Name="ListaResultados">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="#27AE60" 
                               CornerRadius="15" 
                               Padding="13" 
                               Margin="12,5"
                               BackgroundColor="#1A173A"
                               HasShadow="True">
                            <Grid ColumnDefinitions="90,*" 
                                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" 
                                  ColumnSpacing="10"
                                  RowSpacing="8">

                                <!-- Carátula -->
                                <Image Grid.Row="0" Grid.RowSpan="5" Grid.Column="0"
                                       Aspect="AspectFill"
                                       BackgroundColor="#2C3E50"
                                       HeightRequest="80">
                                    <Image.Source>
                                        <UriImageSource Uri="{Binding CoverArt}" 
                                                       CacheValidity="1:00:00:00" />
                                    </Image.Source>
                                </Image>

                                <Label Grid.Row="0" Grid.RowSpan="5" Grid.Column="0"
                                       Text="🎵" 
                                       FontSize="24"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       IsVisible="{Binding CoverArt, Converter={x:Static converters:StringToBoolConverter.Instance}, ConverterParameter='invert'}" />

                                <!-- Información -->
                                <Label Grid.Row="0" Grid.Column="1" 
                                       Text="{Binding Title}" 
                                       FontAttributes="Bold" 
                                       FontSize="16" 
                                       TextColor="#FFFFFF"
                                       LineBreakMode="TailTruncation" />

                                <Label Grid.Row="1" Grid.Column="1" 
                                       Text="{Binding Artist}" 
                                       FontSize="14" 
                                       TextColor="#3498DB"
                                       LineBreakMode="TailTruncation" />

                                <Label Grid.Row="2" Grid.Column="1" 
                                       Text="{Binding Album}" 
                                       FontSize="12" 
                                       TextColor="#BBBBBB"
                                       LineBreakMode="TailTruncation" />

                                <!-- LETRA - SOLO UNA VERSIÓN -->
                                <Frame Grid.Row="3" Grid.Column="1"
                                       BackgroundColor="#2C3E50"
                                       BorderColor="#27AE60"
                                       Padding="12"
                                       Margin="0,8,0,0">
                                    <Label FormattedText="{Binding FormattedLyrics}" 
                                           FontSize="11"
                                           TextColor="#FFFFFF"
                                           LineBreakMode="WordWrap"
                                           MaxLines="6" />
                                </Frame>

                                <VerticalStackLayout Grid.Row="4"
                                                     Grid.Column="1"
                                                     Spacing="10"
                                                     Margin="0,5,0,0">

                                    <!-- Botón Preview -->
                                    <Button Text="{Binding PlayButtonText}"
                                            Clicked="OnPlayPreviewClicked"
                                            BackgroundColor="{Binding PlayButtonColor}"
                                            TextColor="White"
                                            FontSize="12"
                                            HeightRequest="40"
                                            CornerRadius="8"
                                            IsVisible="{Binding PreviewUrl, Converter={StaticResource StringToBoolConverter}}"
                                            CommandParameter="{Binding .}" />

                                    <!-- YouTube / Spotify - MODIFICADO CON ImageButton -->
                                    <HorizontalStackLayout Spacing="10"
                                                           HorizontalOptions="Start">

                                        <ImageButton Source="youtube_icon.png"
                                                     BackgroundColor="#FF0000"
                                                     HeightRequest="40"
                                                     WidthRequest="120"
                                                     CornerRadius="8"
                                                     Aspect="AspectFit"
                                                     Clicked="OnOpenYouTubeClicked"
                                                     CommandParameter="{Binding .}" />

                                        <ImageButton Source="spotify_icon.png"
                                                     BackgroundColor="#1DB954"
                                                     HeightRequest="40"
                                                     WidthRequest="120"
                                                     CornerRadius="8"
                                                     Aspect="AspectFit"
                                                     Clicked="OnOpenSpotifyClicked"
                                                     CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>

                                    <!-- Preview no disponible -->
                                    <Label Text="🎵 Preview no disponible"
                                           FontSize="11"
                                           TextColor="#F39C12"
                                           IsVisible="{Binding PreviewUrl, Converter={x:Static converters:StringToBoolConverter.Instance}, ConverterParameter='invert'}" />

                                </VerticalStackLayout>

                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>

        <!-- Fila 3: Reproductor - MANTENIENDO ELEMENTOS ORIGINALES -->
        <Frame Grid.Row="3"
               x:Name="AudioPlayerFrame"
               IsVisible="False"
               BackgroundColor="#1A173A"
               Padding="15"
               Margin="10,5,10,10"
               CornerRadius="15">
            <VerticalStackLayout Spacing="10">
                <Label x:Name="NowPlayingLabel"
                       Text="Reproduciendo..." 
                       FontSize="14" 
                       FontAttributes="Bold"
                       TextColor="#FFFFFF"
                       HorizontalOptions="Center" />

                <Frame x:Name="LyricsMatchFrame"
                       IsVisible="False"
                       BackgroundColor="#2C3E50"
                       Padding="10">
                    <Label x:Name="LyricsMatchLabel"
                           Text=""
                           FontSize="12"
                           TextColor="#27AE60"
                           LineBreakMode="WordWrap" />
                </Frame>

                <Grid ColumnDefinitions="*,*,*" 
                      ColumnSpacing="10"
                      HorizontalOptions="Center">

                    <Button x:Name="PlayButton"
                            Grid.Column="0"
                            Text="▶ Play"
                            Clicked="OnPlayAudioClicked"
                            BackgroundColor="#27AE60"
                            TextColor="White"
                            FontSize="12"
                            HeightRequest="35"
                            CornerRadius="8" />

                    <Button x:Name="PauseButton"
                            Grid.Column="1"
                            Text="⏸️ Pause"
                            Clicked="OnPauseAudioClicked"
                            BackgroundColor="#3498DB"
                            TextColor="White"
                            FontSize="12"
                            HeightRequest="35"
                            CornerRadius="8" />

                    <Button x:Name="StopButton"
                            Grid.Column="2"
                            Text="⏹️ Stop"
                            Clicked="OnStopAudioClicked"
                            BackgroundColor="#E74C3C"
                            TextColor="White"
                            FontSize="12"
                            HeightRequest="35"
                            CornerRadius="8" />
                </Grid>

                <ProgressBar x:Name="AudioProgressBar"
                             Progress="0"
                             HeightRequest="10"
                             ProgressColor="#27AE60"
                             BackgroundColor="#2C3E50" />

                <Label x:Name="TimeLabel"
                       Text="00:00 / 00:30"
                       FontSize="12"
                       TextColor="#BBBBBB"
                       HorizontalOptions="Center" />

                <Button Text="❌ Cerrar"
                        Clicked="OnClosePlayerClicked"
                        BackgroundColor="#9B59B6"
                        TextColor="White"
                        FontSize="12"
                        HorizontalOptions="End"
                        CornerRadius="8" />
            </VerticalStackLayout>
        </Frame>
    </Grid>
</ContentPage>