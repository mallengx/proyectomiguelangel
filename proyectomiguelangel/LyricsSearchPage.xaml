<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:proyectomiguelangel.Converters"
             x:Class="proyectomiguelangel.LyricsSearchPage"
             Title="Buscar Letras">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Fila 0: Búsqueda -->
        <VerticalStackLayout Grid.Row="0" Padding="20" Spacing="15">
            <Entry x:Name="txtBusqueda"
                   Placeholder="Escribe parte de la letra..."
                   FontSize="18" />

            <Button Text="Buscar canción"
                    Clicked="OnBuscarClicked"
                    BackgroundColor="#2196F3"
                    TextColor="White" />
        </VerticalStackLayout>

        <!-- Fila 1: Loading Indicator -->
        <ActivityIndicator Grid.Row="1"
                           x:Name="LoadingIndicator"
                           IsVisible="False"
                           IsRunning="False"
                           Color="#2196F3"
                           HeightRequest="30"
                           HorizontalOptions="Center"
                           Margin="0,0,0,10" />

        <!-- Fila 2: Lista de canciones CON SCROLL -->
        <ScrollView Grid.Row="2">
            <CollectionView x:Name="ListaResultados">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="LightGray" CornerRadius="12" Padding="13" Margin="12,5">
                            <Grid ColumnDefinitions="90,*" 
                                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" 
                                  ColumnSpacing="10"
                                  RowSpacing="8">

                                <!-- Carátula -->
                                <Image Grid.Row="0" Grid.RowSpan="5" Grid.Column="0"
                                       Aspect="AspectFill"
                                       BackgroundColor="LightGray"
                                       HeightRequest="80">
                                    <Image.Source>
                                        <UriImageSource Uri="{Binding CoverArt}" 
                                                       CacheValidity="1:00:00:00" />
                                    </Image.Source>
                                </Image>

                                <Label Grid.Row="0" Grid.RowSpan="5" Grid.Column="0"
                                       Text="🎵" 
                                       FontSize="24"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       IsVisible="{Binding CoverArt, Converter={x:Static converters:StringToBoolConverter.Instance}, ConverterParameter='invert'}" />

                                <!-- Información -->
                                <Label Grid.Row="0" Grid.Column="1" 
                                       Text="{Binding Title}" 
                                       FontAttributes="Bold" 
                                       FontSize="16" 
                                       LineBreakMode="TailTruncation" />

                                <Label Grid.Row="1" Grid.Column="1" 
                                       Text="{Binding Artist}" 
                                       FontSize="14" 
                                       TextColor="Gray"
                                       LineBreakMode="TailTruncation" />

                                <Label Grid.Row="2" Grid.Column="1" 
                                       Text="{Binding Album}" 
                                       FontSize="12" 
                                       TextColor="DarkGray"
                                       LineBreakMode="TailTruncation" />

                                <!-- LETRA - SOLO UNA VERSIÓN (ACTUALIZADO) -->
                                <Frame Grid.Row="3" Grid.Column="1"
                                       BackgroundColor="{Binding LyricsBackgroundColor}"
                                       BorderColor="{Binding LyricsBorderColor}"
                                       Padding="12"
                                       Margin="0,8,0,0">
                                    <Label FormattedText="{Binding FormattedLyrics}" 
                                           FontSize="11"
                                           LineBreakMode="WordWrap"
                                           MaxLines="6" />
                                </Frame>

                                <VerticalStackLayout Grid.Row="4"
                     Grid.Column="1"
                     Spacing="10"
                     Margin="0,5,0,0">

                                    <!-- Botón Preview -->
                                    <Button Text="{Binding PlayButtonText}"
            Clicked="OnPlayPreviewClicked"
            BackgroundColor="{Binding PlayButtonColor}"
            TextColor="White"
            FontSize="12"
            HeightRequest="40"
            IsVisible="{Binding PreviewUrl, Converter={StaticResource StringToBoolConverter}}"
            CommandParameter="{Binding .}" />

                                    <!-- YouTube / Spotify DEBAJO -->
                                    <HorizontalStackLayout Spacing="10"
                           HorizontalOptions="Start">

                                        <Button Text="▶ YouTube"
                FontSize="11"
                HeightRequest="40"
                BackgroundColor="#FF0000"
                TextColor="White"
                Clicked="OnOpenYouTubeClicked"
                CommandParameter="{Binding .}" />

                                        <Button Text="🎧 Spotify"
                FontSize="11"
                HeightRequest="40"
                BackgroundColor="#1DB954"
                TextColor="White"
                Clicked="OnOpenSpotifyClicked"
                CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>

                                    <!-- Preview no disponible -->
                                    <Label Text="🎵 Preview no disponible"
           FontSize="11"
           TextColor="Orange"
           IsVisible="{Binding PreviewUrl, Converter={x:Static converters:StringToBoolConverter.Instance}, ConverterParameter='invert'}" />

                                </VerticalStackLayout>

                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>

        <!-- Fila 3: Reproductor SIEMPRE VISIBLE cuando está activo -->
        <Frame Grid.Row="3"
               x:Name="AudioPlayerFrame"
               IsVisible="False"
               BackgroundColor="#E3F2FD"
               Padding="15"
               Margin="10,5,10,10">
            <VerticalStackLayout Spacing="10">
                <Label x:Name="NowPlayingLabel"
                       Text="Reproduciendo..." 
                       FontSize="14" 
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />

                <Frame x:Name="LyricsMatchFrame"
                       IsVisible="False"
                       BackgroundColor="#E8F5E8"
                       Padding="10">
                    <Label x:Name="LyricsMatchLabel"
                           Text=""
                           FontSize="12"
                           TextColor="#1B5E20"
                           LineBreakMode="WordWrap" />
                </Frame>

                <Grid ColumnDefinitions="*,*,*" 
                      ColumnSpacing="10"
                      HorizontalOptions="Center">

                    <Button x:Name="PlayButton"
                            Grid.Column="0"
                            Text="▶ Play"
                            Clicked="OnPlayAudioClicked"
                            BackgroundColor="#4CAF50"
                            TextColor="White"
                            FontSize="12"
                            HeightRequest="35" />

                    <Button x:Name="PauseButton"
                            Grid.Column="1"
                            Text="⏸️ Pause"
                            Clicked="OnPauseAudioClicked"
                            BackgroundColor="#FF9800"
                            TextColor="White"
                            FontSize="12"
                            HeightRequest="35" />

                    <Button x:Name="StopButton"
                            Grid.Column="2"
                            Text="⏹️ Stop"
                            Clicked="OnStopAudioClicked"
                            BackgroundColor="#F44336"
                            TextColor="White"
                            FontSize="12"
                            HeightRequest="35" />
                </Grid>

                <ProgressBar x:Name="AudioProgressBar"
                             Progress="0"
                             HeightRequest="10" />

                <Label x:Name="TimeLabel"
                       Text="00:00 / 00:30"
                       FontSize="12"
                       TextColor="#666"
                       HorizontalOptions="Center" />

                <Button Text="❌ Cerrar Reproductor"
                        Clicked="OnClosePlayerClicked"
                        BackgroundColor="#9C27B0"
                        TextColor="White"
                        FontSize="12"
                        HorizontalOptions="End" />
            </VerticalStackLayout>
        </Frame>
    </Grid>
</ContentPage>