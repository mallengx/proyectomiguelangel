<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:proyectomiguelangel.Converters"
             x:Class="proyectomiguelangel.LyricsSearchPage"
             Title="Buscar Letras"
             BackgroundColor="#0F0B23">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <!-- AÑADIDO -->
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Fila 0: Búsqueda -->
        <VerticalStackLayout Grid.Row="0" Padding="20" Spacing="15">
            <Entry x:Name="txtBusqueda"
                   Placeholder="Escribe parte de la letra..."
                   PlaceholderColor="#BBBBBB"
                   TextColor="#FFFFFF"
                   FontSize="18"
                   BackgroundColor="#1A173A"
                   HeightRequest="50"
                   ClearButtonVisibility="WhileEditing"/>

            <Button Text="Buscar canción "
                    Clicked="OnBuscarClicked"
                    BackgroundColor="#27AE60"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    CornerRadius="10" />
        </VerticalStackLayout>

        <!-- Fila 1: Loading Indicator -->
        <ActivityIndicator Grid.Row="1"
                           x:Name="LoadingIndicator"
                           IsVisible="False"
                           IsRunning="False"
                           Color="#27AE60"
                           HeightRequest="30"
                           HorizontalOptions="Center"
                           Margin="0,0,0,10" />

        <!-- Fila 2: Lista de canciones -->
        <ScrollView Grid.Row="2">
            <CollectionView x:Name="ListaResultados"
                          ItemsSource="{Binding .}"
                          VerticalScrollBarVisibility="Always">

                <CollectionView.EmptyView>
                    <StackLayout HorizontalOptions="Center" 
                                 VerticalOptions="Center"
                                 Padding="40"
                                 Spacing="20">
                        <Label Text="🔍"
                               FontSize="48"
                               HorizontalOptions="Center" />
                        <Label Text="Busca una canción por su letra"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#FFFFFF"/>
                        <Label Text="Los resultados aparecerán aquí"
                               FontSize="14"
                               HorizontalOptions="Center"
                               TextColor="#BBBBBB"
                               HorizontalTextAlignment="Center"/>
                    </StackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="#27AE60" 
                               CornerRadius="15" 
                               Padding="13" 
                               Margin="12,5"
                               BackgroundColor="#1A173A"
                               HasShadow="True">
                            <Grid ColumnDefinitions="90,*" 
                                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" 
                                  ColumnSpacing="10"
                                  RowSpacing="8">

                                <!-- Carátula -->
                                <Image Grid.Row="0" Grid.RowSpan="5" Grid.Column="0"
                                       Aspect="AspectFill"
                                       BackgroundColor="#2C3E50"
                                       HeightRequest="80">
                                    <Image.Source>
                                        <UriImageSource Uri="{Binding CoverArt}" 
                                                       CacheValidity="1:00:00:00" 
                                                       CachingEnabled="True"/>
                                    </Image.Source>
                                </Image>

                                <Label Grid.Row="0" Grid.RowSpan="5" Grid.Column="0"
                                       Text="🎵" 
                                       FontSize="24"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       IsVisible="{Binding CoverArt, Converter={StaticResource StringToBoolConverter}, ConverterParameter='invert'}" />

                                <!-- Información -->
                                <Label Grid.Row="0" Grid.Column="1" 
                                       Text="{Binding Title}" 
                                       FontAttributes="Bold" 
                                       FontSize="16" 
                                       TextColor="#FFFFFF"
                                       LineBreakMode="TailTruncation" />

                                <Label Grid.Row="1" Grid.Column="1" 
                                       Text="{Binding Artist}" 
                                       FontSize="14" 
                                       TextColor="#3498DB"
                                       LineBreakMode="TailTruncation" />

                                <Label Grid.Row="2" Grid.Column="1" 
                                       Text="{Binding Album}" 
                                       FontSize="12" 
                                       TextColor="#BBBBBB"
                                       LineBreakMode="TailTruncation" />

                                <!-- LETRA -->
                                <Frame Grid.Row="3" Grid.Column="1"
                                       BackgroundColor="#2C3E50"
                                       BorderColor="#27AE60"
                                       Padding="12"
                                       Margin="0,8,0,0">
                                    <Label FormattedText="{Binding FormattedLyrics}" 
                                           FontSize="11"
                                           TextColor="#FFFFFF"
                                           LineBreakMode="WordWrap"
                                           MaxLines="6" />
                                </Frame>

                                <!-- Botón Preview -->
                                <Button Grid.Row="4" Grid.Column="1"
                                        Text="{Binding PlayButtonText}"
                                        Clicked="OnPlayPreviewClicked"
                                        BackgroundColor="{Binding PlayButtonColor}"
                                        TextColor="White"
                                        FontSize="12"
                                        HeightRequest="40"
                                        CornerRadius="8"
                                        IsVisible="{Binding PreviewUrl, Converter={StaticResource StringToBoolConverter}}"
                                        CommandParameter="{Binding .}"
                                        Margin="0,5,0,0" />

                                <!-- Botón de Favoritos -->
                                <HorizontalStackLayout Grid.Row="5" Grid.Column="1"
                                                       Spacing="10"
                                                       HorizontalOptions="Start"
                                                       Margin="0,5,0,0">
                                    <Button Text="⭐ Añadir a Favoritos"
                                            BackgroundColor="#F1C40F"
                                            TextColor="#1A173A"
                                            FontSize="12"
                                            HeightRequest="35"
                                            CornerRadius="8"
                                            Clicked="OnAddToFavoritesClicked"
                                            CommandParameter="{Binding .}"
                                            IsVisible="{Binding IsFavorite, Converter={StaticResource InvertedBoolConverter}}"/>

                                    <Label Text="⭐ En Favoritos"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#F1C40F"
                                           VerticalOptions="Center"
                                           IsVisible="{Binding IsFavorite}"/>
                                </HorizontalStackLayout>

                                <!-- YouTube / Spotify -->
                                <Grid Grid.Row="6" Grid.Column="1"
      ColumnDefinitions="*,*"
      ColumnSpacing="8"
      Margin="0,5,0,0">

                                    <ImageButton Grid.Column="0"
                 Source="youtube_icon.png"
                 BackgroundColor="#FF0000"
                 HeightRequest="35"
                 CornerRadius="8"
                 Aspect="AspectFit"
                 Clicked="OnOpenYouTubeClicked"
                 CommandParameter="{Binding .}" />

                                    <ImageButton Grid.Column="1"
                 Source="spotify_icon.png"
                 BackgroundColor="#1DB954"
                 HeightRequest="35"
                 CornerRadius="8"
                 Aspect="AspectFit"
                 Clicked="OnOpenSpotifyClicked"
                 CommandParameter="{Binding .}" />
                                </Grid>

                                <!-- Preview no disponible -->
                                <Label Grid.Row="4" Grid.Column="1"
                                       Text="🎵 Preview no disponible"
                                       FontSize="11"
                                       TextColor="#F39C12"
                                       IsVisible="{Binding PreviewUrl, Converter={StaticResource StringToBoolConverter}, ConverterParameter='invert'}"
                                       Margin="0,5,0,0" />

                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>

        <!-- Fila 3: Reproductor -->
        <Frame Grid.Row="3"
               x:Name="AudioPlayerFrame"
               IsVisible="False"
               BackgroundColor="#1A173A"
               Padding="15"
               Margin="10,5,10,10"
               CornerRadius="15">
            <VerticalStackLayout Spacing="10">
                <Label x:Name="NowPlayingLabel"
                       Text="Reproduciendo..." 
                       FontSize="14" 
                       FontAttributes="Bold"
                       TextColor="#FFFFFF"
                       HorizontalOptions="Center" />

                <Frame x:Name="LyricsMatchFrame"
                       IsVisible="False"
                       BackgroundColor="#2C3E50"
                       Padding="10">
                    <Label x:Name="LyricsMatchLabel"
                           Text=""
                           FontSize="12"
                           TextColor="#27AE60"
                           LineBreakMode="WordWrap" />
                </Frame>

                <Grid ColumnDefinitions="*,*,*" 
                      ColumnSpacing="10"
                      HorizontalOptions="Center">

                    <Button x:Name="PlayButton"
                            Grid.Column="0"
                            Text="▶ Play"
                            Clicked="OnPlayAudioClicked"
                            BackgroundColor="#27AE60"
                            TextColor="White"
                            FontSize="12"
                            HeightRequest="35"
                            CornerRadius="8" />

                    <Button x:Name="PauseButton"
                            Grid.Column="1"
                            Text="⏸️ Pause"
                            Clicked="OnPauseAudioClicked"
                            BackgroundColor="#3498DB"
                            TextColor="White"
                            FontSize="12"
                            HeightRequest="35"
                            CornerRadius="8" />

                    <Button x:Name="StopButton"
                            Grid.Column="2"
                            Text="⏹️ Stop"
                            Clicked="OnStopAudioClicked"
                            BackgroundColor="#E74C3C"
                            TextColor="White"
                            FontSize="12"
                            HeightRequest="35"
                            CornerRadius="8" />
                </Grid>

                <ProgressBar x:Name="AudioProgressBar"
                             Progress="0"
                             HeightRequest="10"
                             ProgressColor="#27AE60"
                             BackgroundColor="#2C3E50" />

                <Label x:Name="TimeLabel"
                       Text="00:00 / 00:30"
                       FontSize="12"
                       TextColor="#BBBBBB"
                       HorizontalOptions="Center" />

                <Button Text="❌ Cerrar"
                        Clicked="OnClosePlayerClicked"
                        BackgroundColor="#9B59B6"
                        TextColor="White"
                        FontSize="12"
                        HorizontalOptions="End"
                        CornerRadius="8" />
            </VerticalStackLayout>
        </Frame>
    </Grid>
</ContentPage>