<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="proyectomiguelangel.LyricsTranscriptionPage"
             Title="Transcribir Letras">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Encabezado -->
            <Frame BackgroundColor="#E3F2FD" Padding="15" CornerRadius="10">
                <VerticalStackLayout Spacing="10">
                    <Label Text="🤖 IA de Transcripción" 
                           FontSize="20" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center" />
                    <Label Text="Transcribe letras de canciones usando inteligencia artificial" 
                           FontSize="14" 
                           TextColor="#666"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Frame>

            <!-- Selección de audio -->
            <Frame BackgroundColor="#F5F5F5" Padding="15" CornerRadius="10">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Selecciona el audio a transcribir:" 
                           FontSize="16" 
                           FontAttributes="Bold" />

                    <Button x:Name="SelectFileButton"
                            Text="📁 Seleccionar Archivo"
                            Clicked="OnSelectFileClicked"
                            BackgroundColor="#2196F3"
                            TextColor="White"
                            FontSize="14"
                            HeightRequest="45" />

                    <Label x:Name="SelectedFileLabel"
                           Text="Ningún archivo seleccionado"
                           FontSize="12"
                           TextColor="#666"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Frame>

            <!-- Configuración -->
            <Frame BackgroundColor="#FFF3E0" Padding="15" CornerRadius="10">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Configuración de transcripción:" 
                           FontSize="16" 
                           FontAttributes="Bold" />

                    <Label Text="Idioma (importante para mejor precisión):" FontSize="14" />
                    <Picker x:Name="LanguagePicker"
                            Title="Selecciona el idioma de la canción"
                            FontSize="14"
                            SelectedIndex="0">
                        <Picker.Items>
                            <x:String>Español 🇪🇸</x:String>
                            <x:String>Inglés 🇺🇸</x:String>
                            <x:String>Francés 🇫🇷</x:String>
                            <x:String>Italiano 🇮🇹</x:String>
                            <x:String>Alemán 🇩🇪</x:String>
                            <x:String>Auto-detectar 🤖</x:String>
                        </Picker.Items>
                    </Picker>

                    <Label Text="💡 Selecciona el idioma correcto para mejor precisión. Usa 'Auto-detectar' solo para canciones mixtas."
                           FontSize="11"
                           TextColor="#666"
                           Margin="0,5,0,0" />

                    <HorizontalStackLayout Spacing="10" Margin="0,10,0,0">
                        <CheckBox x:Name="TimestampsCheckBox"
                                  IsChecked="True"
                                  VerticalOptions="Center" />
                        <Label Text="Incluir marcas de tiempo"
                               FontSize="14"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Botones de acción -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button x:Name="TranscribeButton"
                        Grid.Column="0"
                        Text="🚀 Transcribir"
                        Clicked="OnTranscribeClicked"
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        FontSize="16"
                        HeightRequest="50" />

                <Button x:Name="CancelButton"
                        Grid.Column="1"
                        Text="❌ Cancelar"
                        Clicked="OnCancelClicked"
                        BackgroundColor="#F44336"
                        TextColor="White"
                        FontSize="16"
                        HeightRequest="50"
                        IsVisible="False" />
            </Grid>

            <!-- Progreso -->
            <Frame x:Name="ProgressFrame"
                   IsVisible="False"
                   BackgroundColor="#E8F5E8"
                   Padding="15"
                   CornerRadius="10">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <ActivityIndicator x:Name="TranscriptionIndicator"
                                      IsRunning="True"
                                      Color="#4CAF50" />
                    <Label Text="Transcribiendo audio..."
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
                    <Label x:Name="ProgressLabel"
                           Text="Preparando..."
                           FontSize="14"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Frame>

            <!-- Resultados -->
            <Frame x:Name="ResultsFrame"
                   IsVisible="False"
                   BackgroundColor="#E8F5E8"
                   Padding="15"
                   CornerRadius="10">
                <VerticalStackLayout Spacing="10">
                    <Label Text="📝 Letra Transcrita" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           TextColor="#1B5E20" />

                    <ScrollView HeightRequest="300">
                        <Label x:Name="TranscribedLyricsLabel"
                               Text=""
                               FontSize="14"
                               LineBreakMode="WordWrap" />
                    </ScrollView>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                Text="📋 Copiar"
                                Clicked="OnCopyLyricsClicked"
                                BackgroundColor="#2196F3"
                                TextColor="White"
                                FontSize="14" />

                        <Button Grid.Column="1"
                                Text="💾 Guardar"
                                Clicked="OnSaveLyricsClicked"
                                BackgroundColor="#FF9800"
                                TextColor="White"
                                FontSize="14" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>